---
interface Props {
  code: string;
  label?: string;
  name?: string;
}

const { code, label, name = label ?? 'Code snippet' } = Astro.props;
---

<div class="code">
  {label && <span class="code__label">{label}</span>}
  <pre tabindex="0" translate="no"><code>{code}</code></pre>
  <button type="button" class="code__copy" data-copy={code} data-copy-label={name}>
    Copy<span class="sr-only"> {name}</span>
  </button>
</div>
