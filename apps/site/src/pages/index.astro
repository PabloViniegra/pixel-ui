---
import { Badge } from '@pablo-v/react';
import '@pablo-v/react/styles.css';
import '../styles/site.css';
import sansFont from '../../../../packages/tokens/fonts/Geist-Variable.latin.woff2?url';
import pixelFont from '../../../../packages/tokens/fonts/GeistPixel-Square.latin.woff2?url';
import Code from '../components/Code.astro';
import { Demo } from '../components/Demo';
import { HeroScramble } from '../components/HeroScramble';
import { InstallTabs } from '../components/InstallTabs';
import LinkButton from '../components/LinkButton.astro';
import { Showcase } from '../components/Showcase';
import { SiteNav } from '../components/SiteNav';
import { catalog, componentCount, repoUrl, storybookDocs, storybookUrl } from '../data/catalog';

const title = 'PixelUI: React components with a pixel signature';
const description = `${componentCount} accessible React components, each published as its own npm package, with design tokens, Geist Pixel type and a Tailwind CSS v4 preset.`;

const imports = `import '@pablo-v/tokens/styles.css';
import '@pablo-v/button/style.css';`;

const usage = `${imports}
import { Button } from '@pablo-v/button';

export function Deploy({ busy }: { busy: boolean }) {
  return (
    <Button variant="primary" loading={busy}>
      Deploy
    </Button>
  );
}`;

const umbrella = `import '@pablo-v/react/styles.css';
import { Button, Badge, Switch } from '@pablo-v/react';`;

const nextFonts = `// fonts come from next/font
import { GeistSans } from 'geist/font/sans';
import { GeistMono } from 'geist/font/mono';
import { GeistPixelSquare } from 'geist/font/pixel';
import '@pablo-v/tokens/tokens.css';
import '@pablo-v/tokens/motion.css';
import '@pablo-v/tokens/utilities.css';

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html
      lang="en"
      className={\`\${GeistSans.variable} \${GeistMono.variable} \${GeistPixelSquare.variable}\`}
    >
      <body>{children}</body>
    </html>
  );
}`;

const tailwind = `@import "tailwindcss";
@import "@pablo-v/tokens/styles.css";
@import "@pablo-v/tokens/tailwind.css";`;

const tailwindUsage = `<div class="rounded-pxl-lg bg-pxl-bg-subtle shadow-pixel">
  <h2 class="font-pixel text-pxl-xl">Ship it</h2>
</div>`;

const theming = `<!-- follow the OS (default), or force a theme on any element -->
<html data-theme="dark">
  <section data-theme="light">…</section>
</html>`;

const overrides = `:root {
  --pxl-accent: #0f766e;
  --pxl-radius-md: 8px;
}

.marketing {
  --pxl-font-pixel: var(--pxl-font-pixel-grid);
}`;

const mcpClaude = 'claude mcp add pixel-ui -- npx -y @pablo-v/mcp';

const mcpConfig = `{
  "mcpServers": {
    "pixel-ui": {
      "command": "npx",
      "args": ["-y", "@pablo-v/mcp"]
    }
  }
}`;

const skillAdd = 'npx skills add PabloViniegra/pixel-ui';

const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const ogImage = new URL('og.png', pageUrl).href;
const ogImageAlt =
  'PixelUI wordmark in Geist Pixel type with the tagline React components with a pixel signature';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'PixelUI',
  description,
  url: pageUrl,
  codeRepository: repoUrl,
  programmingLanguage: ['TypeScript', 'React'],
  license: 'https://opensource.org/licenses/MIT',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="PixelUI" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={pixelFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const theme = localStorage.getItem('pxl-theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
            meta.setAttribute('content', theme === 'dark' ? '#000000' : '#ffffff');
          }
        }
      } catch {}
    </script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="header">
      <div class="container">
        <SiteNav client:load home={import.meta.env.BASE_URL} storybookUrl={storybookUrl} repoUrl={repoUrl} />
      </div>
    </header>

    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero__copy">
          <Badge tone="accent" appearance="subtle" animateIn={false}>
            {componentCount} components · MIT
          </Badge>
          <h1 id="hero-title" class="hero__title">
            <HeroScramble client:idle />
          </h1>
          <p class="hero__lead">
            Accessible React components you install one package at a time. They sit quietly in a serious product
            and keep one signature: Geist Pixel type and a few <span class="nowrap">8-bit</span> details.
          </p>
          <div class="hero__actions">
            <LinkButton href="#install" size="lg">Get started</LinkButton>
            <LinkButton href={storybookUrl} variant="secondary" size="lg">Open Storybook</LinkButton>
          </div>
        </div>
        <aside class="hero__panel" aria-label="At a glance">
          <dl class="facts">
            <div><dt>Requires</dt><dd>React 19</dd></div>
            <div><dt>Accessibility</dt><dd class="nowrap">WCAG 2.2 AA</dd></div>
            <div><dt>Next.js</dt><dd>App Router ready</dd></div>
            <div><dt>Tailwind CSS</dt><dd>v4 preset</dd></div>
          </dl>
          <Code lang="bash" label="Everything at once" code="pnpm add @pablo-v/react" />
        </aside>
      </section>

      <section class="section container" aria-labelledby="showcase-title">
        <div class="section__head">
          <h2 id="showcase-title" class="section__title">Running on this page</h2>
          <p class="section__lead">
            The published packages, live and wired together. Press Redeploy, or drive it with the keyboard.
          </p>
        </div>
        <Showcase client:visible />
      </section>

      <section class="section container" id="demo" aria-labelledby="demo-title">
        <div class="section__head">
          <h2 id="demo-title" class="section__title">Example app</h2>
          <p class="section__lead">
            A small hosting console assembled only from PixelUI: navigation, tables, forms, overlays and toasts. Every
            control works; nothing leaves this page.
          </p>
        </div>
        <Demo client:visible />
      </section>

      <section class="section container" id="install" aria-labelledby="install-title">
        <div class="section__head">
          <h2 id="install-title" class="section__title">Install</h2>
          <p class="section__lead">
            Requires React 19. Pick single components to keep bundles small, or the umbrella package to get them all.
          </p>
        </div>
        <ol class="steps">
          <li class="step">
            <h3 class="step__title">Add the packages</h3>
            <p class="muted">
              <code>@pablo-v/tokens</code> is the shared peer: CSS variables, Geist fonts and keyframes.
            </p>
            <InstallTabs client:visible />
          </li>
          <li class="step">
            <h3 class="step__title">Import the styles</h3>
            <p class="muted">
              Load the tokens once at the root of your app, then each component's stylesheet. A CSS-aware
              bundler (Vite, Next.js, Astro…) is required.
            </p>
            <Code lang="tsx" label="Single components" code={imports} />
            <Code lang="tsx" label="Umbrella package" code={umbrella} />
          </li>
          <li class="step">
            <h3 class="step__title">Use the components</h3>
            <p class="muted">Every component ships its types; interactive ones are marked <code>"use client"</code>.</p>
            <Code lang="tsx" label="Deploy.tsx" code={usage} />
          </li>
        </ol>
      </section>

      <section class="section container" id="usage" aria-labelledby="usage-title">
        <div class="section__head">
          <h2 id="usage-title" class="section__title">Frameworks and theming</h2>
          <p class="section__lead">Plain CSS with overridable <code>--pxl-*</code> custom properties, so it fits any stack.</p>
        </div>
        <div class="guides">
          <article class="guide">
            <h3 class="guide__title">Next.js</h3>
            <p class="muted">
              Interactive components ship with <code>"use client"</code>, so you can import them straight from Server
              Components. If you load fonts with <code>next/font</code>, import the token files individually instead of
              <code>styles.css</code>: the tokens read the <code>--font-geist-*</code> variables.
            </p>
            <Code lang="tsx" label="app/layout.tsx" name="Next.js layout" code={nextFonts} />
          </article>
          <article class="guide">
            <h3 class="guide__title">Tailwind CSS v4</h3>
            <p class="muted">
              Add the preset after the tokens to get <code>font-pixel</code>, <code>*-pxl-*</code> colours, radii, shadows
              and easings, plus <code>clip-notch</code> and <code>pixelated</code>. Utilities follow the live theme.
            </p>
            <Code lang="css" name="Tailwind CSS setup" code={tailwind} />
            <Code lang="html" name="Tailwind class example" code={tailwindUsage} />
          </article>
          <article class="guide">
            <h3 class="guide__title">Light and dark</h3>
            <p class="muted">
              Themes follow the OS setting by default. Set <code>data-theme="light"</code> or <code>"dark"</code> on any
              element to force one for that subtree.
            </p>
            <Code lang="html" name="Theme attribute example" code={theming} />
          </article>
          <article class="guide">
            <h3 class="guide__title">Tokens</h3>
            <p class="muted">
              Override any token on <code>:root</code> or a container. Components read colours, radii and fonts only from
              tokens, never from literals. <a href={storybookDocs('foundations-tokens')}>All tokens in Storybook</a>.
            </p>
            <Code lang="css" name="Token overrides" code={overrides} />
          </article>
        </div>
      </section>

      <section class="section container" id="mcp" aria-labelledby="mcp-title">
        <div class="section__head">
          <h2 id="mcp-title" class="section__title">Teach your agent PixelUI</h2>
          <p class="section__lead">
            <code>@pablo-v/mcp</code> is a Model Context Protocol server. Connect it to your coding agent and it can look up
            which component fits, its typed props, real examples and the design rules before writing any UI.
          </p>
        </div>
        <div class="guides">
          <article class="guide">
            <h3 class="guide__title">Claude Code</h3>
            <p class="muted">
              Run this once in your project. It needs Node.js; <code>npx</code> fetches the server on first use.
            </p>
            <Code lang="bash" label="Terminal" name="Claude Code MCP command" code={mcpClaude} />
          </article>
          <article class="guide">
            <h3 class="guide__title">What your agent gets</h3>
            <dl class="tools">
              <div><dt><code>list_components</code></dt><dd>The catalogue by category, to choose components.</dd></div>
              <div>
                <dt><code>get_component</code></dt>
                <dd>When to use it and what to use instead, install command, imports, typed API and examples.</dd>
              </div>
              <div><dt><code>get_guide</code></dt><dd>Setup, the design rules and every <code>--pxl-*</code> token.</dd></div>
            </dl>
          </article>
          <article class="guide">
            <h3 class="guide__title">Cursor, Claude Desktop and other clients</h3>
            <p class="muted">
              Add the server to the client's MCP configuration, for example <code>.cursor/mcp.json</code>. It runs over
              stdio, so it works with any client that can start a local command.
            </p>
            <Code lang="json" label="mcp.json" name="MCP client configuration" code={mcpConfig} />
          </article>
          <article class="guide">
            <h3 class="guide__title">Matches the version you install</h3>
            <p class="muted">
              The server answers from data built at release time: the packages' type declarations, their Storybook
              stories and a hand-written usage guide per component. Nothing is fetched at runtime and nothing leaves your
              machine.
            </p>
          </article>
        </div>
      </section>

      <section class="section container" id="skill" aria-labelledby="skill-title">
        <div class="section__head">
          <h2 id="skill-title" class="section__title">A skill for building screens</h2>
          <p class="section__lead">
            The MCP server answers questions; the <code>pixel-ui</code> skill tells your agent when to ask them. Agents
            pick it up automatically when the task is UI in a project that uses PixelUI.
          </p>
        </div>
        <div class="guides">
          <article class="guide">
            <h3 class="guide__title">Install</h3>
            <p class="muted">
              Run this in your project. The <code>skills</code> CLI installs the skill into the folder your agent reads:
              Claude Code, Cursor, Codex and others.
            </p>
            <Code lang="bash" label="Terminal" name="Skill install command" code={skillAdd} />
          </article>
          <article class="guide">
            <h3 class="guide__title">What it teaches</h3>
            <dl class="tools">
              <div><dt>Workflow</dt><dd>Check the setup, map the screen to components, read their docs, then write.</dd></div>
              <div>
                <dt>Choosing</dt>
                <dd>Which of two similar components fits: Dialog or Drawer, Select or Autocomplete, toast or Alert.</dd>
              </div>
              <div><dt>Composition</dt><dd>Patterns for forms, data views, app shells and overlays.</dd></div>
              <div><dt>Design checks</dt><dd>The rules generated code breaks most often, reviewed before finishing.</dd></div>
            </dl>
          </article>
          <article class="guide">
            <h3 class="guide__title">Better with the MCP server</h3>
            <p class="muted">
              The skill does not copy component APIs, so it does not go stale: it sends the agent
              to <a href="#mcp">the MCP server</a> for the facts of the version you installed, and falls back to the
              packages' type declarations when the server is not connected.
            </p>
          </article>
          <article class="guide">
            <h3 class="guide__title">One Markdown file</h3>
            <p class="muted">
              Skills run with your agent's permissions, so read it first: it is a
              single <a href={`${repoUrl}/blob/main/skills/pixel-ui/SKILL.md`}><code>SKILL.md</code></a> with
              instructions and no scripts.
            </p>
          </article>
        </div>
      </section>

      <section class="section container" id="components" aria-labelledby="components-title">
        <div class="section__head">
          <h2 id="components-title" class="section__title">Components</h2>
          <p class="section__lead">
            {componentCount} components, each an independent package. Every name opens its Storybook docs with live
            controls, prop tables and accessibility checks.
          </p>
        </div>
        {
          catalog.map((group) => (
            <section class="group" aria-labelledby={`cat-${group.category.toLowerCase().replace(/\s+/g, '-')}-title`}>
              <div class="group__head">
                <h3 class="group__title" id={`cat-${group.category.toLowerCase().replace(/\s+/g, '-')}-title`}>{group.label}</h3>
                <p class="muted">{group.blurb}</p>
              </div>
              <ul class="entries" role="list">
                {group.entries.map((entry) => (
                  <li class="entry">
                    <a class="entry__title" href={entry.storybook}>{entry.title}<span class="sr-only"> docs</span></a>
                    <p class="entry__desc">{entry.description}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </section>

      <section class="section container" aria-labelledby="versioning-title">
        <div class="versioning">
          <div>
            <h2 id="versioning-title" class="section__title">Versioned one by one</h2>
            <p class="section__lead">
              Each package follows semver on its own and keeps a <code>CHANGELOG.md</code> written by Changesets. Releases
              publish to npm with provenance and tag each package, for example <code>@pablo-v/button@1.0.0</code>.
            </p>
          </div>
          <div class="versioning__actions">
            <LinkButton href={storybookDocs('versions')} variant="secondary">Version table</LinkButton>
            <LinkButton href={`${repoUrl}/blob/main/CONTRIBUTING.md`} variant="ghost">Contributing</LinkButton>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <p class="muted">
          PixelUI code is MIT. Geist, Geist Mono and Geist Pixel are © Vercel, licensed under the SIL Open Font License 1.1.
        </p>
        <nav class="footer__links" aria-label="Resources">
          <a href={storybookUrl}>Storybook</a>
          <a href={repoUrl}>GitHub</a>
          <a href="https://www.npmjs.com/org/pablo-v">npm</a>
        </nav>
      </div>
    </footer>

    <div class="sr-only" role="status" aria-live="polite" id="copy-status"></div>

    <script>
      const status = document.getElementById('copy-status');
      const timers = new WeakMap<HTMLButtonElement, number>();
      document.addEventListener('click', async (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy]');
        if (!button?.dataset.copy) return;
        const what = button.dataset.copyLabel ?? 'Code';
        // Clearing first makes screen readers re-announce an identical message.
        if (status) status.textContent = '';
        try {
          await navigator.clipboard.writeText(button.dataset.copy);
          button.dataset.copied = '';
          if (status) status.textContent = `${what} copied to clipboard`;
          clearTimeout(timers.get(button));
          timers.set(
            button,
            window.setTimeout(() => delete button.dataset.copied, 1600),
          );
        } catch {
          if (status) status.textContent = `Could not copy ${what}`;
        }
      });
    </script>
  </body>
</html>
