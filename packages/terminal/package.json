{
  "name": "@pixel-ui/terminal",
  "version": "1.0.0",
  "description": "Streaming log viewer with autoscroll, level colours and a block cursor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloViniegra/pixel-ui.git",
    "directory": "packages/terminal"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "source": "./src/terminal.css",
      "default": "./dist/terminal.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pixel-ui/core": "workspace:^",
    "@pixel-ui/pixel-icons": "workspace:^"
  },
  "peerDependencies": {
    "@pixel-ui/tokens": "workspace:^",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@pixel-ui/badge": "workspace:^"
  }
}
