{
  "name": "@pixel-ui/loader",
  "version": "0.1.0",
  "description": "3x3 pixel grid loader with snake, pulse and scan patterns",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloViniegra/pixel-ui.git",
    "directory": "packages/loader"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "source": "./src/loader.css",
      "default": "./dist/loader.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pixel-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "@pixel-ui/tokens": "workspace:^",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "pixel",
    "retro",
    "ui",
    "pixel-ui"
  ]
}
