{
  "name": "@pablo-v/hover-card",
  "version": "0.0.0",
  "description": "Rich preview card shown on hover or focus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloViniegra/pixel-ui.git",
    "directory": "packages/hover-card"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "source": "./src/hover-card.css",
      "default": "./dist/hover-card.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pablo-v/core": "workspace:^"
  },
  "peerDependencies": {
    "@pablo-v/tokens": "workspace:^",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@pablo-v/avatar": "workspace:^"
  }
}
