{
  "name": "@pixel-ui/scramble-text",
  "version": "0.1.0",
  "description": "Text that decodes itself from random pixel glyphs",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "source": "./src/scramble-text.css",
      "default": "./dist/scramble-text.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pixel-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "@pixel-ui/tokens": "workspace:^",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "pixel",
    "retro",
    "ui",
    "pixel-ui"
  ]
}
