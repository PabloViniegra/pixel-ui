{
  "name": "@pablo-v/react",
  "version": "0.4.0",
  "description": "All PixelUI components in one package",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloViniegra/pixel-ui.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pablo-v/core": "workspace:^",
    "@pablo-v/tokens": "workspace:^",
    "@pablo-v/button": "workspace:^",
    "@pablo-v/badge": "workspace:^",
    "@pablo-v/switch": "workspace:^",
    "@pablo-v/progress": "workspace:^",
    "@pablo-v/loader": "workspace:^",
    "@pablo-v/card": "workspace:^",
    "@pablo-v/scramble-text": "workspace:^",
    "@pablo-v/pixel-icons": "workspace:^",
    "@pablo-v/field": "workspace:^",
    "@pablo-v/input": "workspace:^",
    "@pablo-v/textarea": "workspace:^",
    "@pablo-v/checkbox": "workspace:^",
    "@pablo-v/radio": "workspace:^",
    "@pablo-v/select": "workspace:^",
    "@pablo-v/slider": "workspace:^",
    "@pablo-v/dialog": "workspace:^",
    "@pablo-v/tooltip": "workspace:^",
    "@pablo-v/popover": "workspace:^",
    "@pablo-v/menu": "workspace:^",
    "@pablo-v/toast": "workspace:^",
    "@pablo-v/tabs": "workspace:^",
    "@pablo-v/breadcrumb": "workspace:^",
    "@pablo-v/accordion": "workspace:^",
    "@pablo-v/table": "workspace:^",
    "@pablo-v/kbd": "workspace:^",
    "@pablo-v/skeleton": "workspace:^",
    "@pablo-v/separator": "workspace:^",
    "@pablo-v/pixel-avatar": "workspace:^",
    "@pablo-v/pixel-image": "workspace:^",
    "@pablo-v/pixel-transition": "workspace:^",
    "@pablo-v/terminal": "workspace:^",
    "@pablo-v/command-menu": "workspace:^",
    "@pablo-v/mini-chart": "workspace:^",
    "@pablo-v/flip-clock": "workspace:^",
    "@pablo-v/alert": "workspace:^",
    "@pablo-v/link": "workspace:^",
    "@pablo-v/chip": "workspace:^",
    "@pablo-v/calendar": "workspace:^",
    "@pablo-v/date-field": "workspace:^",
    "@pablo-v/date-picker": "workspace:^",
    "@pablo-v/date-range-picker": "workspace:^",
    "@pablo-v/autocomplete": "workspace:^",
    "@pablo-v/multi-select": "workspace:^",
    "@pablo-v/color": "workspace:^",
    "@pablo-v/pagination": "workspace:^",
    "@pablo-v/navbar": "workspace:^",
    "@pablo-v/toolbar": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
