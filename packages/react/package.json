{
  "name": "@pixel-ui/react",
  "version": "0.1.0",
  "description": "All PixelUI components in one package",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloViniegra/pixel-ui.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pixel-ui/core": "workspace:^",
    "@pixel-ui/tokens": "workspace:^",
    "@pixel-ui/button": "workspace:^",
    "@pixel-ui/badge": "workspace:^",
    "@pixel-ui/switch": "workspace:^",
    "@pixel-ui/progress": "workspace:^",
    "@pixel-ui/loader": "workspace:^",
    "@pixel-ui/card": "workspace:^",
    "@pixel-ui/scramble-text": "workspace:^",
    "@pixel-ui/pixel-icons": "workspace:^",
    "@pixel-ui/field": "workspace:^",
    "@pixel-ui/input": "workspace:^",
    "@pixel-ui/textarea": "workspace:^",
    "@pixel-ui/checkbox": "workspace:^",
    "@pixel-ui/radio": "workspace:^",
    "@pixel-ui/select": "workspace:^",
    "@pixel-ui/slider": "workspace:^",
    "@pixel-ui/dialog": "workspace:^",
    "@pixel-ui/tooltip": "workspace:^",
    "@pixel-ui/popover": "workspace:^",
    "@pixel-ui/menu": "workspace:^",
    "@pixel-ui/toast": "workspace:^",
    "@pixel-ui/tabs": "workspace:^",
    "@pixel-ui/breadcrumb": "workspace:^",
    "@pixel-ui/accordion": "workspace:^",
    "@pixel-ui/table": "workspace:^",
    "@pixel-ui/kbd": "workspace:^",
    "@pixel-ui/skeleton": "workspace:^",
    "@pixel-ui/separator": "workspace:^",
    "@pixel-ui/pixel-avatar": "workspace:^",
    "@pixel-ui/pixel-image": "workspace:^",
    "@pixel-ui/pixel-transition": "workspace:^",
    "@pixel-ui/terminal": "workspace:^",
    "@pixel-ui/command-menu": "workspace:^",
    "@pixel-ui/mini-chart": "workspace:^",
    "@pixel-ui/flip-clock": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
