{
  "name": "@pablo-v/resizable",
  "version": "0.1.1",
  "description": "Resizable panel groups with draggable handles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloViniegra/pixel-ui.git",
    "directory": "packages/resizable"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "source": "./src/resizable.css",
      "default": "./dist/resizable.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pablo-v/core": "workspace:^"
  },
  "peerDependencies": {
    "@pablo-v/tokens": "workspace:^",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
